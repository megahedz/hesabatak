name: Build حساباتك APK

on:
  workflow_dispatch:
    inputs:
      api_base_url:
        description: "Backend URL the app should call (e.g. your Render URL)"
        required: true
        default: "http://10.0.2.2:8000"
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: subosito/flutter-action@v2
        with:
          flutter-version: "3.24.0"
          channel: "stable"

      - name: Install dependencies
        working-directory: mobile
        run: flutter pub get

      - name: Build release APK
        working-directory: mobile
        run: >
          flutter build apk --release
          --dart-define=API_BASE_URL=${{ github.event.inputs.api_base_url || 'http://10.0.2.2:8000' }}

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: hesabatak-app
          path: mobile/build/app/outputs/flutter-apk/app-release.apk
